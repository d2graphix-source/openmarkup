# Copy to .env.local for local development. On Vercel, add the same names under Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Lets the server act for share-link guests on one review at a time. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of this app, no trailing slash. Used for share links and to find the OpenMarkup script.
APP_ORIGIN=https://openmarkup.example.com

# Optional. "true" shows a sign-up form on the login page. Leave off to create logins in Supabase > Authentication > Users.
ALLOW_SIGNUP=false

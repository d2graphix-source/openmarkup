{
  "name": "openmarkup",
  "version": "0.1.0",
  "private": true,
  "description": "Pin comments on a live website and export them as Markdown.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-review.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/review/tests/*.test.mjs\"",
    "test:e2e": "node --experimental-strip-types src/review/tests/e2e.mjs",
    "build:review": "node scripts/build-review.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.460.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "modern-screenshot": "^4.7.0",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
